# ─── Site ────────────────────────────────────────────────────────────────
# Public URL with no trailing slash. Used for canonical URLs, sitemap, OG images, emails.
NEXT_PUBLIC_SITE_URL=https://reelless.tashanto.com
# Shown on the contact/about pages and used as the default contact-form recipient.
NEXT_PUBLIC_CONTACT_EMAIL=hello@tashanto.com

# ─── Database (waitlist) ─────────────────────────────────────────────────
# PostgreSQL connection string. Without it, the waitlist logs to the console in dev
# and returns an error in production.
DATABASE_URL=postgresql://reelless:password@localhost:5432/reelless

# ─── Email (Resend) ──────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are printed to the server console in development.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend.
EMAIL_FROM="Reelless <hello@tashanto.com>"
# Where contact-form messages go (defaults to NEXT_PUBLIC_CONTACT_EMAIL).
CONTACT_TO_EMAIL=

# ─── Spam protection (optional) ──────────────────────────────────────────
# Cloudflare Turnstile. Leave both empty to disable (honeypot + rate limit still apply).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Store listings / feature flags ──────────────────────────────────────
# Set to true only when the listing is live; this shows the official store button.
NEXT_PUBLIC_PLAY_STORE_LIVE=false
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.tashanto.reelless
NEXT_PUBLIC_CHROME_STORE_LIVE=false
NEXT_PUBLIC_CHROME_STORE_URL=
# Show "N people are on the list" (only ever shown when ≥ 100 confirmed sign-ups).
NEXT_PUBLIC_SHOW_WAITLIST_COUNT=false

# ─── Analytics (optional, cookieless) ────────────────────────────────────
# Umami or Plausible script URL + website id. No cookies, no banner needed.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# ─── Social links (optional; empty ones are hidden) ──────────────────────
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# ─── Development only ────────────────────────────────────────────────────
# Adds a temporary `ar` locale (English copy, right-to-left layout) to check RTL readiness.
NEXT_PUBLIC_ENABLE_RTL_PREVIEW=false
