{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start --port 3220",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3220/en",
        "http://localhost:3220/en/features",
        "http://localhost:3220/en/block-youtube-shorts",
        "http://localhost:3220/en/guides/stop-watching-youtube-shorts"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
